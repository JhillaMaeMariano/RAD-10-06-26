import java.util.Scanner;

// A# Diagnostic activity (Data types)
class Main {
    public static void main(String[] args) {
        
        Scanner scanner = new Scanner(System.in);

        System.out.print("Enter your name: ");
        String name = scanner.nextLine();

        System.out.print("Enter your age: ");
        int age = scanner.nextInt();

        scanner.nextLine();
        
        System.out.print("Enter your address: ");
        String address = scanner.nextLine();
        
        System.out.print("Enter your weight in kg: ");
        double weight = scanner.nextDouble();
        
        System.out.print("Enter your height in cm: ");
        double height = scanner.nextDouble();

        System.out.println("\nI am " + name + ", I'm " + age + " years old. I live in " + address + ". My height is " + height + " cm, and my weight is " + weight + "kg.");

// A#2 Diagnostic activity (Swithch case, and loops)  
boolean calcu = true;

while (calcu) {
        System.out.print("\nEnter the value of x: ");
        int x = scanner.nextInt();

        System.out.print("Enter the value of y: ");
        int y = scanner.nextInt();

        System.out.println("\n-----ARITHMETIC OPERATORS-----");
        System.out.println("+ - Addition");
        System.out.println("- - Subtraction");
        System.out.println("* - Multiplication");              
        System.out.println("/ - Division");   

        scanner.nextLine();

        System.out.print("\nChoose arithmetic operators: ");
        String arithmeticOp = scanner.nextLine();

        switch (arithmeticOp) {
                case "+": 
                    System.out.print("Result: " + x + " + " + y + " = " + (x + y));
                    break;
                case "-": 
                    System.out.print("Result: " + x + " - " + y + " = " + (x - y));
                    break;
                case "*": 
                    System.out.print("Result: " + x + " * " + y + " = " + (x * y));
                    break;
                case "/": 
                    if (y == 0){
                    System.out.print("Error: Division by zero is not allowed.");
                    } else {
                        System.out.print("Result: " + x + " / " + y + " = " + (x / y));
                    }
                    break;
                default:
                    System.out.println("Invalid operator selected.");
                    break;
        }
        
        scanner.close();
        }
    }     
}
